{
  "expo": {
    "name": "Домашний бар",
    "slug": "domashniy-bar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "de.kreisphoto.domashniybar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020d09"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Домашний бар",
      "shortName": "Бар",
      "themeColor": "#020d09",
      "backgroundColor": "#020d09"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#020d09",
          "imageWidth": 200
        }
      ]
    ]
  }
}
