{
  "expo": {
    "name": "Домашний бар",
    "slug": "domashniy-bar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.inmybar"
    },
    "android": {
      "package": "app.inmybar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020d09"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Домашний бар",
      "shortName": "Бар",
      "themeColor": "#020d09",
      "backgroundColor": "#020d09"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#020d09",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "176f9f21-0e28-4848-9751-e786666f6fe5"
      }
    },
    "owner": "sergkreiss-team"
  }
}
